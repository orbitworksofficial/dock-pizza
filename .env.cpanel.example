APP_NAME="Dock Pizza"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dockpizzamd.com

# Used by /clear-cache?token=... and /clear-cache.php?token=...
CACHE_CLEAR_TOKEN=PizzaViva2026

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---------------------------------------------------------------------------
# cPanel MySQL (fill these in cPanel → MySQL Databases)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_cpanel_db_name
DB_USERNAME=your_cpanel_db_user
DB_PASSWORD=your_cpanel_db_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.dockpizzamd.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.dockpizzamd.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="orders@dockpizzamd.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Maps Places (required for address autocomplete on production)
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Payments / POS — Clover
# Keep production + sandbox keys both filled. Switch only CLOVER_ENVIRONMENT.
# sandbox  = test cards  |  production = real money (DOCK PIZZA)
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY=clover
CLOVER_ENVIRONMENT=production

# LIVE (www.clover.com → DOCK PIZZA → Account & Setup → API Tokens / eComm)
CLOVER_PRODUCTION_MERCHANT_ID=T955203X2VC31
CLOVER_PRODUCTION_ACCESS_TOKEN=
CLOVER_PRODUCTION_ECOMMERCE_PRIVATE_KEY=
CLOVER_PRODUCTION_PUBLIC_KEY=

# SANDBOX / testing keys (https://sandbox.dev.clover.com — NOT www.clover.com)
# Dashboard path: Account & Setup → API tokens  +  Ecommerce / eComm API tokens
# URL example: sandbox.dev.clover.com/setupapp/m/{merchantId}/ecomm-api-tokens
# Test cards: https://docs.clover.com/dev/docs/test-card-numbers
CLOVER_SANDBOX_MERCHANT_ID=
CLOVER_SANDBOX_ACCESS_TOKEN=
CLOVER_SANDBOX_ECOMMERCE_PRIVATE_KEY=
CLOVER_SANDBOX_PUBLIC_KEY=


# Square alternative (optional)
# PAYMENT_GATEWAY=square
# SQUARE_ENVIRONMENT=production
# SQUARE_APPLICATION_ID=
# SQUARE_ACCESS_TOKEN=
# SQUARE_LOCATION_ID=
