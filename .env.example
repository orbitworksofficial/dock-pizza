APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/New_York

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Payments / POS
# ---------------------------------------------------------------------------
PAYMENT_GATEWAY=clover

# Active Clover mode: "sandbox" for test cards, "production" for real charges.
# Both credential sets can stay filled; only CLOVER_ENVIRONMENT is switched.
CLOVER_ENVIRONMENT=sandbox

# --- Live / production (DOCK PIZZA dashboard: https://www.clover.com ) ---
# Ecommerce keys: Account & Setup → API Tokens → eComm / Ecommerce API tokens
CLOVER_PRODUCTION_MERCHANT_ID=T955203X2VC31
CLOVER_PRODUCTION_ACCESS_TOKEN=
CLOVER_PRODUCTION_ECOMMERCE_PRIVATE_KEY=
CLOVER_PRODUCTION_PUBLIC_KEY=

# --- Sandbox / testing (https://sandbox.dev.clover.com ) ---
# 1. Open https://sandbox.dev.clover.com  (NOT www.clover.com)
# 2. Create / open a sandbox developer app + test merchant
# 3. Sandbox dashboard → Account & Setup → API tokens (REST) and Ecommerce API tokens
# 4. URL looks like: sandbox.dev.clover.com/setupapp/m/{merchantId}/ecomm-api-tokens
# Test cards: https://docs.clover.com/dev/docs/test-card-numbers
CLOVER_SANDBOX_MERCHANT_ID=
CLOVER_SANDBOX_ACCESS_TOKEN=
CLOVER_SANDBOX_ECOMMERCE_PRIVATE_KEY=
CLOVER_SANDBOX_PUBLIC_KEY=

# Legacy single-set vars (optional fallback if PRODUCTION_/SANDBOX_ vars are empty)
# CLOVER_MERCHANT_ID=
# CLOVER_ACCESS_TOKEN=
# CLOVER_ECOMMERCE_PRIVATE_KEY=
# CLOVER_PUBLIC_KEY=
